.app-nav { position: fixed; z-index: 50; left: 0; right: 0; bottom: 0; padding-bottom: env(safe-area-inset-bottom); background: rgba(255,253,247,.98); border-top: 1rpx solid #ecece1; box-shadow: 0 -8rpx 32rpx rgba(68,83,55,.025); }
.nav-bar { height: 108rpx; display: flex; align-items: center; justify-content: space-around; }
.nav-item { flex: 1; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #a0a893; gap: 8rpx; }.nav-item:active { opacity: .65; }
.nav-label { font-size: 19rpx; line-height: 1.2; letter-spacing: 1rpx; }.is-active { color: #4b7758; font-weight: 750; }
.nav-icon { width: 35rpx; height: 32rpx; position: relative; box-sizing: border-box; }
.icon-home { border: 2.5rpx solid currentColor; border-radius: 11rpx 11rpx 9rpx 9rpx; }.is-active .icon-home { background: #e4ecd9; }
.icon-home .icon-detail { width: 9rpx; height: 11rpx; border: 2rpx solid currentColor; border-bottom: 0; position: absolute; bottom: 0; left: 9rpx; border-radius: 5rpx 5rpx 0 0; }
.icon-book { border: 2.5rpx solid currentColor; border-radius: 6rpx; }.icon-book::after { content: ""; height: 100%; border-left: 2rpx solid currentColor; position: absolute; left: 50%; }.is-active .icon-book { background: #e4ecd9; }
.icon-community { border: 2.5rpx solid currentColor; border-radius: 12rpx; }.icon-community::after { content: ""; position: absolute; bottom: -6rpx; left: 6rpx; width: 7rpx; height: 7rpx; border-left: 2rpx solid currentColor; transform: skewY(-30deg); background: #fffdf7; }.icon-community .icon-detail { position: absolute; left: 7rpx; right: 7rpx; top: 12rpx; border-top: 2rpx solid currentColor; }
.icon-me::before { content: ""; width: 12rpx; height: 12rpx; border-radius: 50%; border: 2.5rpx solid currentColor; position: absolute; left: 9rpx; top: -2rpx; }.icon-me::after { content: ""; position: absolute; left: 3rpx; right: 2rpx; bottom: -2rpx; height: 13rpx; border: 2.5rpx solid currentColor; border-radius: 16rpx 16rpx 6rpx 6rpx; }
.is-publish .nav-icon { width: 72rpx; height: 60rpx; margin-top: -5rpx; border-radius: 22rpx; background: #749773; color: #fffdf4; box-shadow: 0 5rpx 12rpx rgba(91,128,84,.13); }.icon-plus::before, .icon-plus::after { content: ""; position: absolute; background: currentColor; border-radius: 3rpx; top: 50%; left: 50%; transform: translate(-50%,-50%); }.icon-plus::before { width: 25rpx; height: 3rpx; }.icon-plus::after { width: 3rpx; height: 25rpx; }.is-publish .nav-label { color: #819273; }
.nav-item { color: #728069; }
.nav-label { font-size: 22rpx; }
.is-active { color: #3b6e51; }
