<view class="page register-page">
  <view class="register-brand"><image class="register-logo" src="{{logoUrl}}" mode="aspectFit" /><view><text class="register-name">观微元</text><text class="register-wordmark">DELTASCOPE</text></view></view>
  <view class="card auth-card">
    <text class="register-eyebrow">A NEW BEGINNING</text>
    <text class="brand">开启探索</text>
    <text class="subtitle">记录每一步思考，发现数学的更多可能。</text>
    <view class="form-field"><text class="field-label">手机号</text><input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" /></view>
    <view class="form-field"><text class="field-label">设置密码</text><input class="input" password maxlength="128" placeholder="至少 8 个字符" value="{{password}}" bindinput="onPasswordInput" /></view>
    <view class="account-note"><text class="note-dot"></text><text>新账号默认为学生，可在个人信息中认证为教师。</text></view>
    <button class="btn-primary register-button" bindtap="handleRegister" loading="{{loading}}" disabled="{{loading}}">创建账号</button>
    <view class="switch-line" bindtap="goLogin">已有账号？<text class="login-link">去登录 →</text></view>
  </view>
  <text class="register-footer">观察 · 推导 · 见证成长</text>
</view>
