.register-page { padding: 52rpx 34rpx; background: radial-gradient(ellipse at 100% 0%, #e7e6ef 0%, transparent 40%), var(--canvas-gradient); }
.register-brand { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 8rpx 44rpx; }
.register-logo { width: 88rpx; height: 88rpx; flex-shrink: 0; border-radius: 50%; box-shadow: 0 8rpx 22rpx rgba(71, 64, 111, .12); }
.register-name { display: block; color: var(--color-primary-dark); font-size: 36rpx; font-weight: 750; letter-spacing: 4rpx; }
.register-wordmark { display: block; color: var(--color-accent); font-size: 18rpx; letter-spacing: 4rpx; margin-top: 3rpx; }
.auth-card { border: 1rpx solid var(--color-line); padding: 40rpx 30rpx 32rpx; border-radius: 30rpx; }
.register-eyebrow { display: block; color: var(--color-accent); font-size: 18rpx; letter-spacing: 3rpx; }
.brand { display: block; margin-top: 14rpx; color: var(--color-ink); font-size: 44rpx; font-weight: 750; }
.subtitle { display: block; margin: 12rpx 0 34rpx; color: var(--color-muted); font-size: 24rpx; line-height: 1.7; }
.form-field { margin-top: 24rpx; }
.field-label { display: block; margin-bottom: 12rpx; color: var(--color-ink); font-size: 24rpx; font-weight: 600; }
.input { background: #f8f6ee; height: 88rpx; padding: 0 22rpx; border: 1rpx solid var(--color-line); border-radius: 18rpx; color: var(--color-ink); font-size: 26rpx; }
.account-note { display: flex; align-items: flex-start; gap: 10rpx; margin-top: 24rpx; color: var(--color-muted); font-size: 21rpx; line-height: 1.7; }
.note-dot { width: 8rpx; height: 8rpx; flex-shrink: 0; margin-top: 13rpx; border-radius: 50%; background: var(--color-accent); }
.register-button { height: 88rpx; margin-top: 32rpx; border-radius: 18rpx; font-size: 28rpx; }
.switch-line { margin-top: 24rpx; text-align: center; color: var(--color-muted); font-size: 23rpx; }
.login-link { color: var(--color-primary-dark); margin-left: 8rpx; font-weight: 600; }
.register-footer { display: block; margin-top: 36rpx; color: var(--color-muted); text-align: center; font-size: 21rpx; letter-spacing: 2rpx; }
.register-button { width: 100%; }
.account-note { font-size: 24rpx; }
