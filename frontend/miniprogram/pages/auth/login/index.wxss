page { min-height: 100vh; background: #f5f2e9; }
.password-toggle { padding: 16rpx 0 16rpx 18rpx; color: #527358; font-size: 23rpx; }
.login-page { position: relative; min-height: 100vh; overflow: hidden; padding: 36rpx 34rpx 36rpx; background: radial-gradient(ellipse at 100% 0%, #ebe8f2 0%, transparent 38%), linear-gradient(180deg, #f5f2e9 0%, #f8f5eb 56%, #eff2e8 100%); }
.login-page::before { content: ""; position: absolute; width: 520rpx; height: 520rpx; top: -300rpx; right: -190rpx; border-radius: 50%; background: rgba(212, 173, 98, .12); }
.login-page::after { content: ""; position: absolute; width: 400rpx; height: 400rpx; bottom: 50rpx; left: -300rpx; border-radius: 50%; background: rgba(108, 165, 140, .11); }
.login-art { position: relative; height: 310rpx; margin: 0 8rpx; overflow: hidden; border-radius: 36rpx; background: radial-gradient(circle at 95% 5%, rgba(125,120,157,.3), transparent 48%), linear-gradient(138deg, #8db69e 0%, #619d87 48%, #398577 100%); box-shadow: 0 24rpx 54rpx rgba(55, 113, 91, .16); }
.login-art::before { content: ""; position: absolute; width: 460rpx; height: 240rpx; bottom: -156rpx; left: -48rpx; border-radius: 50%; background: rgba(245, 242, 233, .12); transform: rotate(-18deg); }
.login-art::after { content: ""; position: absolute; width: 360rpx; height: 200rpx; bottom: -148rpx; right: -80rpx; border-radius: 50%; background: rgba(244, 223, 181, .14); transform: rotate(22deg); }
.art-orbit { position: absolute; border: 1rpx solid rgba(255, 250, 232, .22); border-radius: 50%; }
.orbit-one { width: 330rpx; height: 330rpx; top: -132rpx; right: -72rpx; }
.orbit-two { width: 230rpx; height: 230rpx; top: -82rpx; right: -22rpx; }
.brand-mark { position: absolute; top: 46rpx; left: 50%; width: 146rpx; height: 146rpx; padding: 6rpx; border: 1rpx solid rgba(255,255,255,.48); border-radius: 50%; background: rgba(250, 247, 233, .18); box-shadow: 0 12rpx 28rpx rgba(40,73,58,.16); transform: translateX(-50%); }
.brand-logo { display: block; width: 100%; height: 100%; border-radius: 50%; }
.mark-spark { position: absolute; top: -18rpx; right: -17rpx; width: 42rpx; height: 42rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; color: #896d38; background: #f1dcaa; font-size: 24rpx; box-shadow: 0 5rpx 16rpx rgba(40,73,58,.14); }
.art-dot { position: absolute; border-radius: 50%; background: #eed8a3; box-shadow: 0 0 18rpx rgba(240, 220, 171, .3); }
.dot-one { top: 62rpx; left: 112rpx; width: 12rpx; height: 12rpx; }.dot-two { top: 206rpx; right: 102rpx; width: 9rpx; height: 9rpx; opacity: .8; }.dot-three { top: 49rpx; right: 164rpx; width: 7rpx; height: 7rpx; opacity: .72; }
.art-caption { position: absolute; right: 0; bottom: 38rpx; left: 0; color: rgba(255, 250, 232, .74); font-size: 18rpx; text-align: center; letter-spacing: 5rpx; }
.login-intro { position: relative; z-index: 1; padding: 28rpx 10rpx 24rpx; text-align: center; }
.brand-name { display: block; color: #2f6858; font-size: 42rpx; font-weight: 800; letter-spacing: 8rpx; }
.brand-subtitle { display: block; margin-top: 9rpx; color: #78857e; font-size: 23rpx; letter-spacing: 1rpx; }
.login-card { position: relative; z-index: 1; padding: 36rpx 30rpx 28rpx; border: 1rpx solid rgba(227, 232, 223, .9); border-radius: 30rpx; background: rgba(255, 254, 250, .94); box-shadow: 0 20rpx 54rpx rgba(55, 92, 74, .09); }
.card-heading { margin-bottom: 20rpx; }
.card-title { display: block; color: #263b35; font-size: 34rpx; font-weight: 750; }
.card-copy { display: block; margin-top: 7rpx; color: #89938c; font-size: 22rpx; }
.input-label { display: block; margin-top: 18rpx; color: #52695e; font-size: 22rpx; font-weight: 600; }
.field-wrap { height: 88rpx; display: flex; align-items: center; margin-top: 10rpx; padding: 0 20rpx; border: 1rpx solid #e7e9df; border-radius: 18rpx; background: #f8f6ee; }
.field-icon { position: relative; flex-shrink: 0; margin-right: 22rpx; color: #8aab94; box-sizing: border-box; }
.phone-icon { width: 20rpx; height: 30rpx; border: 2rpx solid currentColor; border-radius: 5rpx; }.phone-icon::after { content: ""; position: absolute; width: 6rpx; height: 2rpx; bottom: 3rpx; left: 5rpx; border-radius: 2rpx; background: currentColor; }
.lock-icon { width: 23rpx; height: 20rpx; margin-top: 10rpx; border: 2rpx solid currentColor; border-radius: 4rpx; }.lock-icon::before { content: ""; position: absolute; width: 11rpx; height: 13rpx; left: 4rpx; top: -14rpx; border: 2rpx solid currentColor; border-bottom: 0; border-radius: 8rpx 8rpx 0 0; }
.input { min-width: 0; height: 86rpx; flex: 1; color: #263b35; font-size: 26rpx; }
.login-button { position: relative; height: 88rpx; margin-top: 28rpx; border-radius: 18rpx; color: #fffefa; background: var(--brand-gradient); box-shadow: 0 12rpx 24rpx rgba(67, 140, 120, .19); font-size: 28rpx; font-weight: 700; letter-spacing: 2rpx; }
.login-button:active { opacity: .9; transform: translateY(1rpx); }.button-arrow { margin-left: 10rpx; font-size: 34rpx; font-weight: 400; vertical-align: -2rpx; }
.register-hint { display: flex; justify-content: center; gap: 8rpx; margin-top: 23rpx; color: #89938c; font-size: 22rpx; }.register-link { color: #438c78; font-weight: 700; }
.login-foot { position: relative; z-index: 1; display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 34rpx; color: #9ba49a; font-size: 19rpx; letter-spacing: 1rpx; }.foot-line { width: 42rpx; height: 1rpx; background: #d9dfd3; }
.login-page { padding: 24rpx 34rpx 36rpx; }
.login-art { height: 240rpx; box-shadow: none; background: linear-gradient(125deg, #dce8d6, #d8e7dd 65%, #e1ddea); }
.brand-mark { top: 26rpx; width: 134rpx; height: 134rpx; box-shadow: 0 8rpx 24rpx rgba(60,92,64,.1); }
.art-orbit { border-color: rgba(75,128,103,.18); }
.art-caption { bottom: 28rpx; color: #526e58; font-size: 19rpx; letter-spacing: 3rpx; }
.login-intro { padding: 22rpx 4rpx; }
.brand-name { font-size: 38rpx; }
.brand-subtitle, .card-copy, .register-hint, .login-foot { color: #697563; font-size: 24rpx; }
.login-card { box-shadow: var(--shadow-card); padding: 30rpx; }
.input-label { font-size: 24rpx; }
.login-button { width: 100%; }
