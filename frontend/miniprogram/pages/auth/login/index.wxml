<view class="login-page">
  <view class="login-art" aria-hidden="true">
    <view class="art-orbit orbit-one"></view><view class="art-orbit orbit-two"></view>
    <view class="art-dot dot-one"></view><view class="art-dot dot-two"></view><view class="art-dot dot-three"></view>
    <view class="brand-mark"><image class="brand-logo" src="{{logoUrl}}" mode="aspectFit" /><view class="mark-spark">✦</view></view>
    <text class="art-caption">OBSERVE · DERIVE · GROW</text>
  </view>
  <view class="login-intro">
    <text class="brand-name">观微元</text>
    <text class="brand-subtitle">让每一次思考，都成为成长的刻度</text>
  </view>
  <view class="login-card">
    <view class="card-heading"><text class="card-title">用户登录</text><text class="card-copy">欢迎回来，继续探索数学的美</text></view>
    <text class="input-label">手机号</text><view class="field-wrap"><view class="field-icon phone-icon"></view><input class="input" type="number" maxlength="11" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput" /></view>
    <text class="input-label">密码</text><view class="field-wrap"><view class="field-icon lock-icon"></view><input class="input" password="{{!showPassword}}" maxlength="128" placeholder="请输入登录密码" value="{{password}}" bindinput="onPasswordInput" confirm-type="done" bindconfirm="handleLogin" /><text class="password-toggle" bindtap="togglePassword" role="button" aria-label="{{showPassword ? '隐藏密码' : '显示密码'}}">{{showPassword ? '隐藏' : '显示'}}</text></view>
    <text class="form-error" wx:if="{{error}}" role="alert">{{error}}</text>
    <button class="btn-primary login-button" loading="{{loading}}" disabled="{{loading}}" bindtap="handleLogin">登录 <text class="button-arrow">→</text></button>
    <view class="register-hint"><text>还没有账号？</text><text class="register-link" bindtap="goRegister">创建新账号</text></view>
  </view>
  <view class="login-foot"><view class="foot-line"></view><text>观察 · 推导 · 见证成长</text><view class="foot-line"></view></view>
</view>
