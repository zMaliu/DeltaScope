.profile-heading { display: flex; align-items: center; justify-content: space-between; margin: 4rpx 0 40rpx; font-size: 40rpx; font-weight: 750; }.profile-brand { color: #bdc2b1; font-size: 17rpx; font-weight: 400; letter-spacing: 3rpx; }
.profile-identity { display: flex; align-items: center; gap: 22rpx; }.profile-avatar { width: 116rpx; height: 116rpx; flex-shrink: 0; padding: 5rpx; background: #fffdf7; border: 1rpx solid #e0e5d6; border-radius: 50%; box-shadow: 0 6rpx 18rpx rgba(69,88,61,.05); }.profile-avatar image { width: 100%; height: 100%; border-radius: 50%; }.identity-copy { min-width: 0; flex: 1; }.identity-name { display: block; font-size: 35rpx; font-weight: 750; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }.identity-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10rpx; color: #9aa28e; font-size: 19rpx; margin-top: 13rpx; }.identity-role { padding: 4rpx 12rpx; border-radius: 8rpx; color: #7c9270; background: #e7eddc; }.edit-profile { padding: 12rpx 21rpx; border: 1rpx solid #dde3d2; border-radius: 15rpx; color: #8a9a7a; font-size: 21rpx; }
.profile-quote { display: flex; gap: 10rpx; align-items: center; padding: 27rpx 0 34rpx; font-size: 22rpx; color: #9ca68f; }.quote-spark { color: #b6bb95; }
.my-learning { border: 1rpx solid #e1e6d6; background: linear-gradient(135deg,#edf1e4,#e4ebdb); padding: 25rpx; border-radius: 27rpx; margin-bottom: 24rpx; }.my-learning-head { display: flex; align-items: center; justify-content: space-between; color: #6c835e; font-size: 23rpx; font-weight: 650; }.my-learning-head > text:last-child { color: #9ca98a; font-size: 19rpx; font-weight: 400; }.profile-stats { display: flex; margin-top: 25rpx; padding-bottom: 3rpx; }.profile-stats > view { flex: 1; text-align: center; border-right: 1rpx solid #dbe2d0; }.profile-stats > view:last-child { border: 0; }.profile-stat-number { display: block; color: #5c7b52; font-size: 42rpx; font-weight: 700; line-height: 1.2; }.profile-stat-label { display: block; margin-top: 9rpx; color: #96a184; font-size: 20rpx; }
.profile-menu { background: #fffdf7; border: 1rpx solid #e9e9dd; border-radius: 25rpx; padding: 0 23rpx; overflow: hidden; }.menu-row { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 0; border-bottom: 1rpx solid #efeee5; }.menu-row:last-child { border: 0; }.menu-icon { width: 58rpx; height: 58rpx; display: flex; align-items: center; justify-content: center; border-radius: 18rpx; flex-shrink: 0; color: #8ca27b; background: #eaf0e0; font: 31rpx Georgia,serif; }.menu-icon.violet { color: #aaa0b7; background: #efecf4; }.menu-icon.sand { color: #b5a17d; background: #f4eddf; }.menu-copy { flex: 1; min-width: 0; }.menu-title { display: block; font-size: 25rpx; font-weight: 600; color: #586f4f; }.menu-desc { display: block; font-size: 19rpx; color: #a5ac99; margin-top: 6rpx; }.menu-arrow { font-size: 32rpx; color: #afb79e; }
.details-card { padding: 10rpx 25rpx; border-radius: 22rpx; background: #f0f1e6; margin-top: 14rpx; }.detail-row { display: flex; justify-content: space-between; gap: 20rpx; padding: 16rpx 0; font-size: 22rpx; color: #9aa48c; }.detail-row > text:last-child { text-align: right; color: #7b8c6c; max-width: 65%; word-break: break-word; }
.cert-card { display: flex; align-items: center; gap: 15rpx; padding: 24rpx; border-radius: 23rpx; background: #efedf4; border: 1rpx solid #e7e3ee; margin-top: 24rpx; }.cert-icon { display: flex; width: 44rpx; height: 48rpx; align-items: center; justify-content: center; color: #a59bb6; font-size: 27rpx; border: 2rpx solid #cdc5d9; border-radius: 16rpx 16rpx 22rpx 22rpx; }.cert-title { display: block; font-size: 24rpx; font-weight: 650; color: #8a809a; }.cert-desc { display: block; font-size: 18rpx; color: #afa6bb; margin-top: 7rpx; }.cert-action { color: #a79cb5; font-size: 19rpx; flex-shrink: 0; }.certified-state { padding: 24rpx; border-radius: 22rpx; color: #8b9f7a; background: #eaf0e0; margin-top: 24rpx; font-size: 23rpx; }
.logout-button { margin-top: 34rpx; padding: 7rpx; color: #a8aa98; font-size: 23rpx; background: transparent; border-radius: 16rpx; }.profile-footer { display: block; margin-top: 17rpx; text-align: center; color: #b5b9a8; font-size: 18rpx; letter-spacing: 1rpx; }
.sheet-mask { position: fixed; inset: 0; z-index: 100; background: rgba(38,52,41,.3); display: flex; align-items: flex-end; }.cert-sheet { width: 100%; border-radius: 36rpx 36rpx 0 0; padding: 18rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); background: #fffdf7; }.sheet-handle { height: 7rpx; width: 64rpx; background: #d9dfcf; border-radius: 5rpx; margin: 0 auto 28rpx; }.sheet-heading { display: flex; justify-content: space-between; align-items: center; font-size: 34rpx; font-weight: 700; color: #496342; }.sheet-close { padding: 0 10rpx; font-size: 42rpx; color: #a3ad98; font-weight: 400; }.sheet-copy { display: block; margin: 17rpx 0 28rpx; font-size: 24rpx; color: #87947a; line-height: 1.8; }.cert-input { height: 90rpx; padding: 0 24rpx; background: #f0f2e7; border: 1rpx solid #dde4d2; border-radius: 18rpx; font-size: 27rpx; margin-bottom: 24rpx; }.cert-error { display: block; color: #ac6d5d; font-size: 23rpx; margin: -6rpx 0 20rpx; }.sheet-note { display: block; margin-top: 20rpx; text-align: center; font-size: 21rpx; color: #9da78e; }
.identity-meta, .identity-role, .edit-profile, .profile-quote, .profile-stat-label, .menu-desc, .detail-row, .logout-button, .sheet-copy, .sheet-note { color: #67765d; font-size: 24rpx; }
.my-learning-head > text:last-child, .profile-footer { color: #6c795f; font-size: 22rpx; }
.cert-title { color: #756681; font-size: 27rpx; }
.cert-desc, .cert-action { color: #7c7089; font-size: 22rpx; }
.menu-title { font-size: 28rpx; color: #425b3e; }
.sheet-close { padding: 4rpx 12rpx; color: #6c795f; }
.sheet-mask { overflow: hidden; }
