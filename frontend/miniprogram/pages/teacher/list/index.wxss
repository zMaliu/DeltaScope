.teacher-hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 38rpx 34rpx;
  border-radius: 38rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 18% 0%, rgba(240, 223, 185, 0.35), transparent 34%),
    linear-gradient(135deg, #6ca58c, #438c78 75%);
  box-shadow: 0 20rpx 56rpx rgba(67, 140, 120, 0.18);
}

.eyebrow {
  display: block;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 52rpx;
  font-weight: 900;
}

.hero-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.74);
  font-size: 26rpx;
  line-height: 1.6;
}

.profile-orb {
  flex: 0 0 auto;
  width: 82rpx;
  height: 82rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f6858;
  background: rgba(255, 255, 255, 0.9);
  font-weight: 900;
}

.teacher-actions {
  display: grid;
  grid-template-columns: 1.5fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.action-card {
  min-height: 150rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 16rpx 42rpx rgba(32, 41, 56, 0.08);
}

.action-card.primary {
  color: #ffffff;
  background: linear-gradient(145deg, #6ca58c, #438c78);
}

.action-title {
  display: block;
  font-size: 36rpx;
  font-weight: 900;
}

.action-desc {
  display: block;
  margin-top: 12rpx;
  color: #687386;
  font-size: 24rpx;
  line-height: 1.45;
}

.primary .action-desc {
  color: rgba(255, 255, 255, 0.78);
}

.submission-card {
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 16rpx 42rpx rgba(32, 41, 56, 0.08);
}

.submission-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.student-name {
  display: block;
  color: #263b35;
  font-size: 32rpx;
  font-weight: 900;
}

.submit-time {
  display: block;
  margin-top: 10rpx;
  color: #78857e;
  font-size: 24rpx;
}

.tag {
  flex: 0 0 auto;
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  line-height: 42rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.tag-submitted {
  background: #f5eddc;
  color: #8e713d;
}

.tag-graded {
  background: rgba(31, 122, 112, 0.12);
  color: #438c78;
}

.submission-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #edf1ef;
  color: #1f7a70;
  font-size: 24rpx;
  font-weight: 800;
}

.empty-panel {
  padding: 42rpx 34rpx;
  border-radius: 34rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx dashed rgba(67, 140, 120, 0.24);
}

.empty-title {
  display: block;
  color: #263b35;
  font-size: 34rpx;
  font-weight: 900;
}

.page-shell { background: var(--canvas-gradient); }

.empty-copy {
  display: block;
  margin-top: 12rpx;
  color: #687386;
  line-height: 1.6;
}
.teacher-hero { background: var(--hero-gradient); box-shadow: none; color: var(--color-ink); border-radius: 26rpx; padding: 30rpx; }
.hero-title { font-size: 42rpx; font-weight: 750; margin-top: 8rpx; }
.eyebrow { color: var(--color-primary); font-size: 20rpx; }
.hero-copy { color: var(--color-muted); font-size: 24rpx; }
.action-card, .submission-card { border: 1rpx solid var(--color-line); border-radius: 24rpx; box-shadow: var(--shadow-card); }
.action-card.primary { background: var(--brand-gradient); }
