.library-heading { margin: 8rpx 0 30rpx; }.library-title { display: block; font-size: 39rpx; font-weight: 750; letter-spacing: -1rpx; }.library-sub { display: block; color: #98a08e; font-size: 23rpx; margin-top: 10rpx; }
.resource-list { overflow: hidden; border-radius: 26rpx; border: 1rpx solid #e9e9dd; background: #fffdf7; }.resource-row { display: flex; align-items: center; gap: 21rpx; margin: 0 24rpx; padding: 26rpx 0; border-bottom: 1rpx solid #efeee4; }.resource-row:last-child { border-bottom: 0; }.resource-cover { position: relative; flex-shrink: 0; width: 116rpx; height: 156rpx; border-radius: 12rpx 20rpx 20rpx 12rpx; overflow: hidden; box-shadow: -4rpx 2rpx 0 #dde3d4; }.resource-cover image { width: 100%; height: 100%; }.resource-cover > text { position: absolute; bottom: 20rpx; left: 20rpx; color: #9ca88e; font: 38rpx Georgia,serif; }.resource-copy { flex: 1; min-width: 0; }.resource-category { display: block; font-size: 18rpx; color: #98a68a; }.resource-title { display: block; font-size: 26rpx; line-height: 1.6; font-weight: 650; margin-top: 5rpx; }.resource-summary { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #a0a692; font-size: 20rpx; margin-top: 6rpx; }.resource-status { display: inline-block; margin-top: 12rpx; padding: 4rpx 10rpx; font-size: 17rpx; border-radius: 8rpx; background: #f1f1e7; color: #a2a88f; }.resource-arrow { color: #abb39e; font-size: 30rpx; }.library-foot { display: block; text-align: center; color: #adb29f; font-size: 20rpx; margin-top: 28rpx; }
