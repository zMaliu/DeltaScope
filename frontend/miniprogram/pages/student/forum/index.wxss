.community-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 6rpx 0 26rpx; }.community-title { display: block; font-size: 37rpx; font-weight: 750; letter-spacing: -1rpx; }.community-sub { display: block; font-size: 22rpx; color: #98a08e; margin-top: 10rpx; }.compose-entry { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 22rpx; color: #fffdf7; background: #769873; font-size: 36rpx; font-weight: 300; }
.community-banner { position: relative; overflow: hidden; display: flex; align-items: center; justify-content: space-between; gap: 14rpx; padding: 24rpx; border-radius: 22rpx; background: #e9eddf; border: 1rpx solid #e2e7d6; }.community-banner::after { content: ""; position: absolute; right: -30rpx; top: -60rpx; width: 180rpx; height: 180rpx; border: 1rpx solid #d5dfcb; border-radius: 50%; }.banner-copy { position: relative; z-index: 1; }.banner-title { display: block; font-size: 25rpx; color: #637d56; font-weight: 650; }.banner-sub { display: block; font-size: 19rpx; color: #99a48b; margin-top: 8rpx; }.banner-symbol { color: #b6c4a5; font: 72rpx Georgia,serif; margin-right: 12rpx; line-height: 1; transform: rotate(12deg); }
.community-sub, .banner-sub { font-size: 24rpx; color: #68785f; }
