.note-page { padding: 36rpx 36rpx 70rpx; background: #fffdf7; }.article-channel { display: flex; align-items: center; gap: 16rpx; color: #8da378; font-size: 21rpx; }.article-status { border: 1rpx solid #e5e5d5; color: #a0a48a; padding: 4rpx 10rpx; border-radius: 8rpx; font-size: 17rpx; }.article-title { display: block; margin-top: 23rpx; font-size: 41rpx; font-weight: 750; line-height: 1.5; letter-spacing: -.5rpx; color: #415b37; }.article-author { display: flex; align-items: center; gap: 14rpx; margin-top: 28rpx; }.author-avatar { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border-radius: 50%; background: #eaf0df; color: #94a77d; font-size: 24rpx; }.author-name { display: block; color: #7f916e; font-size: 23rpx; }.article-date { display: block; font-size: 19rpx; color: #aeb69f; margin-top: 4rpx; }.article-rule { height: 1rpx; background: #eaeadd; margin: 29rpx 0; }.article-content { display: block; white-space: pre-wrap; word-break: break-word; font-size: 29rpx; line-height: 2; color: #617553; }.article-notice { margin-top: 30rpx; border-left: 4rpx solid #d5dfc6; background: #f1f4e9; color: #91a07e; padding: 20rpx 24rpx; font-size: 23rpx; line-height: 1.8; }.article-end { display: flex; align-items: center; justify-content: center; gap: 10rpx; margin: 64rpx 0 28rpx; color: #b4bca5; font-size: 21rpx; }.article-compose { border-radius: 18rpx; font-size: 24rpx; padding: 8rpx; background: #eaf0df; color: #7d9467; }
.article-date, .article-notice, .article-end, .article-channel { color: #69795e; font-size: 24rpx; }
.article-compose { color: #496b3f; min-height: 76rpx; padding: 14rpx 24rpx; }
.article-content { color: #3d5037; font-size: 31rpx; }
