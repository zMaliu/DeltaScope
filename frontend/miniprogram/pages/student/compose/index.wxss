.compose-page { padding-bottom: calc(160rpx + env(safe-area-inset-bottom)); }.compose-top { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 8rpx 0 26rpx; }.compose-heading { font-size: 32rpx; font-weight: 700; }.draft-state { color: #9da88f; font-size: 19rpx; }
.compose-paper { padding: 28rpx; border: 1rpx solid #e5e7d9; border-radius: 25rpx; background: #fffdf7; }.compose-title-input { height: 76rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #eeede1; font-size: 31rpx; font-weight: 650; color: #45603c; }.compose-content { width: 100%; height: 400rpx; padding-top: 22rpx; line-height: 1.9; font-size: 26rpx; color: #617453; }.compose-wordcount { margin-top: 16rpx; text-align: right; font-size: 19rpx; color: #a6ad97; }
.compose-settings { margin-top: 27rpx; padding: 25rpx; border: 1rpx solid #e8e8da; border-radius: 23rpx; background: #fffdf7; }.settings-label { display: block; font-size: 23rpx; color: #7a8a69; font-weight: 600; margin-bottom: 18rpx; }.channel-options { display: flex; flex-wrap: wrap; gap: 12rpx; }.channel-option { padding: 12rpx 17rpx; border-radius: 13rpx; font-size: 21rpx; color: #9da78d; background: #f2f2e8; }.channel-option.active { color: #658051; background: #e4ecd9; font-weight: 650; }.course-setting { display: flex; align-items: center; gap: 15rpx; border-top: 1rpx solid #f0efe4; padding-top: 21rpx; margin-top: 23rpx; }.course-setting > text { font-size: 23rpx; color: #7d8e6d; }.course-setting > input { flex: 1; text-align: right; font-size: 23rpx; color: #748866; }
.compose-tip { display: flex; gap: 10rpx; font-size: 21rpx; color: #a2aa92; padding: 25rpx 8rpx; line-height: 1.8; }.compose-tip > text:first-child { color: #b6bd9c; }.publish-footer { position: fixed; bottom: 0; left: 0; right: 0; z-index: 20; padding: 18rpx 30rpx calc(22rpx + env(safe-area-inset-bottom)); background: rgba(246,244,235,.97); border-top: 1rpx solid #e9eadd; }.publish-button { margin: 0; }
.draft-state, .compose-wordcount, .compose-tip, .channel-option { color: #6c795f; font-size: 23rpx; }
