.learning-header { margin: 4rpx 0 30rpx; }.learning-title { display: block; font-size: 42rpx; font-weight: 750; letter-spacing: -1rpx; }.learning-sub { display: block; margin-top: 10rpx; color: #98a08e; font-size: 23rpx; }
.learning-summary { padding: 28rpx; border: 1rpx solid #e0e7d6; border-radius: 28rpx; background: linear-gradient(140deg,#ecf0e2,#dfe9d9); margin-bottom: 22rpx; }.summary-heading { display: flex; justify-content: space-between; color: #5a7556; font-size: 24rpx; font-weight: 600; }.summary-decor { color: #9eaf91; }.summary-stats { display: flex; justify-content: space-around; margin: 28rpx 0; }.summary-stats > view { flex: 1; text-align: center; border-right: 1rpx solid #d6e0ce; }.summary-stats > view:last-child { border: 0; }.stat-value { display: block; font-size: 46rpx; font-weight: 700; color: #426447; line-height: 1.1; font-variant-numeric: tabular-nums; }.stat-label { display: block; font-size: 21rpx; color: #85977a; margin-top: 12rpx; }.summary-foot { display: block; padding-top: 18rpx; border-top: 1rpx solid rgba(121,151,110,.15); color: #94a186; font-size: 19rpx; text-align: center; }
.learning-entry { display: flex; align-items: center; gap: 20rpx; border: 1rpx solid #eaeade; padding: 25rpx 24rpx; background: #fffdf7; border-radius: 23rpx; margin-top: 16rpx; }.entry-icon { display: flex; width: 65rpx; height: 65rpx; align-items: center; justify-content: center; flex-shrink: 0; background: #e9efdf; border-radius: 20rpx; color: #829970; font: 38rpx Georgia,serif; }.entry-icon.lavender { background: #eeebf3; color: #9c92ad; }.entry-copy { flex: 1; min-width: 0; }.entry-title { display: block; font-size: 26rpx; font-weight: 650; }.entry-desc { display: block; font-size: 21rpx; color: #98a08e; margin-top: 6rpx; }.entry-arrow { color: #a7b09c; font-size: 34rpx; }
.record-card { border: 1rpx solid #eaeade; padding: 8rpx 26rpx; border-radius: 24rpx; background: #fffdf7; }.record-row { padding: 21rpx 0; border-bottom: 1rpx solid #f0efe5; }.record-row:last-child { border-bottom: 0; }.record-top { display: flex; justify-content: space-between; color: #74866b; font-size: 23rpx; }.record-value { color: #99a38d; font-size: 21rpx; }.record-track { height: 6rpx; margin-top: 17rpx; background: #eff1e6; border-radius: 5rpx; overflow: hidden; }.record-fill { height: 100%; background: #a7bd95; border-radius: 5rpx; }
.lab-grid { display: flex; gap: 18rpx; }.lab-tile { flex: 1; min-width: 0; position: relative; padding: 26rpx 24rpx; border-radius: 23rpx; overflow: hidden; }.lab-art { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: .65; }.lab-symbol,.lab-name,.lab-caption,.lab-state { position: relative; z-index: 1; display: block; }.lab-symbol { font: 50rpx Georgia,serif; color: #8f98a2; margin-bottom: 24rpx; }.lab-name { font-size: 27rpx; font-weight: 650; color: #5c7160; }.lab-caption { font-size: 19rpx; color: #98a08e; margin-top: 6rpx; }.lab-state { position: absolute; top: 20rpx; right: 18rpx; font-size: 17rpx; padding: 4rpx 10rpx; border-radius: 8rpx; background: rgba(255,253,247,.7); color: #8c9b81; }
.ai-entry { display: flex; align-items: center; gap: 15rpx; border: 1rpx solid #e8e4ed; border-radius: 22rpx; background: #f0eef4; padding: 23rpx 21rpx; margin-top: 19rpx; }.ai-icon { color: #b3aac2; font-size: 33rpx; }.ai-entry .entry-title { font-size: 23rpx; color: #7c7490; }.ai-entry .entry-desc { font-size: 19rpx; color: #a39caf; }.ai-badge { flex-shrink: 0; font-size: 17rpx; color: #a69cb4; }
.learning-sub, .stat-label, .summary-foot, .entry-desc, .record-value, .lab-caption { color: #68785f; font-size: 24rpx; }
.summary-foot, .lab-state { font-size: 22rpx; }
.ai-entry .entry-desc, .ai-badge { color: #766b88; font-size: 22rpx; }
