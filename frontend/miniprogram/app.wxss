@import "styles/tokens.wxss";
.btn-primary { width: 100% !important; }
.form-error { display: block; color: #a2483d; font-size: 24rpx; line-height: 1.6; margin: 18rpx 0 0; }
page { background: var(--color-canvas); color: var(--color-ink); font-size: 28rpx; line-height: 1.5; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif; }
view, input, textarea, button, scroll-view { box-sizing: border-box; }
button::after { border: 0; } button { font-size: 28rpx; } button[disabled] { opacity: .5; }
button, [role="button"] { transition: opacity .15s, transform .15s; } button:active, [role="button"]:active { opacity: .78; }
.page, .page-shell { min-height: 100vh; padding: 28rpx 30rpx 52rpx; background: var(--canvas-gradient); }
.with-nav { padding-bottom: calc(148rpx + env(safe-area-inset-bottom)); }
.card { background: var(--color-surface); border: 1rpx solid var(--color-line); border-radius: 26rpx; padding: 30rpx; box-shadow: var(--shadow-card); margin-bottom: 24rpx; }
.btn-primary { padding: 16rpx 28rpx; min-height: 86rpx; display: flex; align-items: center; justify-content: center; color: #fffdf7; background: var(--brand-gradient); border-radius: 20rpx; font-weight: 650; font-size: 28rpx; box-shadow: 0 8rpx 20rpx rgba(75,128,103,.12); }
.btn-primary:active { opacity: .85; transform: translateY(1rpx); }
.section-heading { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; margin: 32rpx 0 20rpx; }
.section-title { display: block; color: var(--color-ink); font-size: 32rpx; font-weight: 750; letter-spacing: -.5rpx; }
.section-more { color: #7b9077; font-size: 21rpx; flex-shrink: 0; }
.pill { display: inline-flex; padding: 7rpx 16rpx; border-radius: 999rpx; background: var(--color-primary-soft); color: var(--color-primary); font-size: 21rpx; font-weight: 600; }
.muted { color: var(--color-muted); }.screen-head { display: flex; align-items: center; justify-content: space-between; margin: 8rpx 0 26rpx; }
.screen-eyebrow { display: block; color: var(--color-primary); font-size: 19rpx; letter-spacing: 3rpx; margin-bottom: 6rpx; }
.screen-title { display: block; font-size: 44rpx; font-weight: 750; letter-spacing: -1rpx; line-height: 1.25; }
.screen-copy { display: block; margin-top: 12rpx; font-size: 24rpx; color: var(--color-muted); }
.search-bar { display: flex; align-items: center; gap: 14rpx; height: 78rpx; background: #eeeee5; border: 1rpx solid transparent; border-radius: 21rpx; padding: 0 24rpx; margin-bottom: 24rpx; }
.search-mark { width: 23rpx; height: 23rpx; border: 2.5rpx solid #98a28f; border-radius: 50%; position: relative; flex-shrink: 0; margin-right: 6rpx; }.search-mark::after { content: ""; width: 9rpx; height: 2.5rpx; background: #98a28f; position: absolute; right: -7rpx; bottom: -3rpx; transform: rotate(45deg); }
.search-input { flex: 1; min-width: 0; height: 76rpx; font-size: 24rpx; color: var(--color-ink); }.search-clear { padding: 14rpx; font-size: 30rpx; color: var(--color-muted); }
.filter-scroll { white-space: nowrap; margin-bottom: 24rpx; width: 100%; }.filter-chip { display: inline-block; padding: 11rpx 23rpx; margin-right: 12rpx; border-radius: 15rpx; font-size: 23rpx; color: #929c88; background: #eeeee4; }.filter-chip.active { color: #45694e; background: #e0e8d7; font-weight: 700; }
.waterfall { display: flex; align-items: flex-start; gap: 18rpx; }.waterfall-column { flex: 1; min-width: 0; }
.note-card { overflow: hidden; border-radius: 23rpx; background: var(--color-surface); border: 1rpx solid #eeede3; margin-bottom: 18rpx; box-shadow: 0 4rpx 18rpx rgba(69,88,61,.025); }
.note-cover { position: relative; height: 260rpx; overflow: hidden; background: #e3ecdf; }.note-cover.tall { height: 310rpx; }.note-art { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }
.note-cover-label { position: absolute; z-index: 1; top: 17rpx; left: 17rpx; padding: 5rpx 11rpx; border-radius: 9rpx; background: rgba(255,253,247,.77); font-size: 17rpx; color: #64775c; font-weight: 600; }
.note-cover-title { position: absolute; z-index: 1; bottom: 23rpx; left: 22rpx; right: 18rpx; color: #4d6a48; font-size: 30rpx; line-height: 1.45; font-weight: 700; white-space: pre-line; }
.note-body { padding: 18rpx 18rpx 20rpx; }.note-title { display: block; font-size: 25rpx; font-weight: 650; line-height: 1.6; word-break: break-word; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.note-desc { color: var(--color-muted); font-size: 21rpx; margin-top: 8rpx; line-height: 1.65; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.note-foot { display: flex; align-items: center; justify-content: space-between; gap: 8rpx; font-size: 18rpx; color: #a0a793; margin-top: 18rpx; }.note-author { display: flex; align-items: center; gap: 8rpx; min-width: 0; flex: 1; }.note-author-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mini-avatar { display: inline-flex; width: 30rpx; height: 30rpx; align-items: center; justify-content: center; border-radius: 50%; background: #e9eddf; color: #8c9f80; font-size: 17rpx; flex-shrink: 0; }
.note-meta { flex-shrink: 0; font-size: 18rpx; }.loading-state, .feed-end { text-align: center; color: #a2aa95; font-size: 21rpx; padding: 30rpx 12rpx; }
.empty-state { padding: 56rpx 28rpx; text-align: center; color: var(--color-muted); }.empty-orbit { display: block; margin-bottom: 18rpx; color: #b2c1a9; font: 76rpx Georgia,serif; }.empty-title { display: block; font-size: 28rpx; font-weight: 650; color: #6f8167; }.empty-copy { display: block; margin-top: 10rpx; font-size: 23rpx; line-height: 1.7; }.retry-link { display: inline-block; margin-top: 18rpx; color: #64835d; font-size: 23rpx; font-weight: 600; }
.error-card { background: #fffdf7; border: 1rpx solid var(--color-line); border-radius: 22rpx; padding: 26rpx; margin: 20rpx 0; }.error-copy { display: block; color: var(--color-muted); margin: 12rpx 0 20rpx; font-size: 24rpx; }.quiet-button { display: inline-block; background: var(--color-primary-soft); color: var(--color-primary); border-radius: 14rpx; padding: 10rpx 22rpx; font-size: 24rpx; margin: 14rpx 0 0; line-height: 1.6; }
.filter-chip { color: #68755f; }
.note-foot, .note-meta { color: #707a66; font-size: 21rpx; }
.note-cover-label { font-size: 20rpx; background: rgba(255,253,247,.92); }
.mini-avatar { color: #59754e; font-size: 19rpx; }
.loading-state, .feed-end, .section-more { color: #697563; font-size: 23rpx; }
