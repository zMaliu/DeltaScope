.preview-art { display: block; width: 100%; height: 310rpx; border-radius: 26rpx; }
.plan-notice { padding: 28rpx 0; }
.plan-copy { display: block; margin-top: 18rpx; font-size: 26rpx; line-height: 1.85; color: var(--color-muted); }
.catalog { padding: 0 28rpx; background: var(--color-surface); border: 1rpx solid var(--color-line); border-radius: 26rpx; }
.catalog-row { display: flex; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--color-line); }
.catalog-row:last-child { border-bottom: 0; }
.catalog-index { color: var(--color-accent); font: 28rpx Georgia,serif; flex-shrink: 0; padding-top: 4rpx; }
.catalog-title { display: block; font-size: 29rpx; font-weight: 650; }
.catalog-copy { display: block; font-size: 25rpx; color: var(--color-muted); line-height: 1.8; margin-top: 10rpx; }
.plan-illustration { padding: 48rpx 24rpx; background: var(--color-accent-soft); color: var(--color-accent); font-size: 84rpx; text-align: center; border-radius: 26rpx; }
.plan-illustration text { display: block; font-size: 27rpx; margin-top: 16rpx; }
.plan-button { margin-top: 28rpx; }
